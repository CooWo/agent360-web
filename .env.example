# 복사해서 .env 로 쓰세요:  copy .env.example .env  (Mac: cp)
# 설명은 값 뒤가 아니라 위 줄에 씁니다.

# ── 공통 ──────────────────────────────
# local | prod  (local 이면 오른쪽 위에서 사용자 전환 가능, prod 는 IAP 로그인만)
ENV=local
APP_TITLE=상담사 360
# sample | bigquery
DATA_BACKEND=sample
# local 첫 로그인 사용자
DEV_USER=sv.kim@example.com

# ── BigQuery (DATA_BACKEND=bigquery 일 때) ──
# 새 프로젝트 ID (소문자)
GCP_PROJECT=v12-2027
BQ_LOCATION=asia-northeast3
# 공통 데이터셋: dim_agent, fact_* (Capacity Web 과 공유)
COMMON_DATASET=common
# 모듈 데이터셋: user_roles, fact_coaching, mart_signals, audit_log
MODULE_DATASET=agent360
CAPACITY_DATASET=capacity
ROSTER_DATASET=roster
CACHE_SECONDS=60

# ── IAP (ENV=prod 일 때) ────────────────
# 설정하면 IAP JWT 서명까지 확인. 값은 콘솔 IAP 화면에서 복사
IAP_AUDIENCE=
# prod 에서 이 도메인 계정만 통과
ALLOWED_DOMAINS=ubase.co.kr

# ── AI 질문: 기존 BigQuery 데이터 에이전트 연결 ──
# 비우면 AI 질문 메뉴가 '미설정'으로 보입니다. 내 PC 에서는 내 gcloud 로그인(ADC) 권한으로 호출합니다.
AI_AGENT_PROJECT=v11-2026
AI_AGENT_LOCATION=global
# AI BA CHAT (Volume)
AI_AGENT_ID=agent_f682354b-7695-4008-b37e-9d4cff706829
AI_AGENT_LABEL=AI BA CHAT (Volume)
# 사용량·요금이 잡힐 프로젝트 (비우면 AI_AGENT_PROJECT)
AI_QUOTA_PROJECT=
